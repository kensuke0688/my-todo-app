# Supabase: Dashboard > Connect > ORMs > Prisma
# Pooled connection (port 6543) - used by the app at runtime via Prisma
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct/session connection (port 5432) - used by `prisma db push` / migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase client (browser + proxy). Safe to expose - limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<publishable-or-anon-key>"
